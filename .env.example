# =============================================================================
# Podshelf Configuration
# Copy this file to .env and fill in your values.
# =============================================================================

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Path to the SQLite database file. Will be created automatically.
DATABASE_PATH=./data/podshelf.db

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# Secret key used for signing tokens / future auth features.
NUXT_SECRET_KEY=change-me-to-a-long-random-string

# Simple admin password — protects the /admin area.
# Leave empty to disable password protection (useful for local dev).
ADMIN_PASSWORD=changeme

# API key for automation (OpenClaw, scripts, etc.) — separate from ADMIN_PASSWORD.
# Set to a long random string. Used via X-Api-Key or Authorization: Bearer headers.
# Leave empty to disable API key auth.
PODSHELF_API_KEY=

# -----------------------------------------------------------------------------
# Public site URL (used in RSS feed links, canonical URLs, etc.)
# -----------------------------------------------------------------------------
SITE_URL=https://yourpodcast.example.com

# -----------------------------------------------------------------------------
# Storage Adapter
# Choose: sftp  or  s3
# -----------------------------------------------------------------------------
STORAGE_ADAPTER=sftp

# -----------------------------------------------------------------------------
# SFTP Storage (shared hosting, Dreamhost, etc.)
# -----------------------------------------------------------------------------
SFTP_HOST=yourhost.example.com
SFTP_PORT=22
SFTP_USER=yourusername

# Path to your SSH private key file on the machine running Podshelf.
SFTP_PRIVATE_KEY_PATH=/home/youruser/.ssh/id_rsa

# Remote directory on the server where audio files will be uploaded.
SFTP_REMOTE_DIR=/home/youruser/public_html/podcast/audio

# The public-facing base URL that corresponds to SFTP_REMOTE_DIR.
SFTP_PUBLIC_URL_BASE=https://yourhost.example.com/podcast/audio

# -----------------------------------------------------------------------------
# S3 / Backblaze B2 Storage
# -----------------------------------------------------------------------------
# For AWS S3, leave S3_ENDPOINT blank. For Backblaze B2 or other S3-compatible
# providers, set S3_ENDPOINT to their S3-compatible endpoint URL.
S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com

S3_REGION=us-west-004
S3_ACCESS_KEY_ID=your-key-id
S3_SECRET_ACCESS_KEY=your-secret-key
S3_BUCKET_NAME=your-bucket-name

# The public-facing base URL for your bucket/CDN.
S3_PUBLIC_URL_BASE=https://f004.backblazeb2.com/file/your-bucket-name
