# =============================================================================
# Podshelf Configuration
# Copy this file to .env and fill in your values.
# =============================================================================

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Path to the SQLite database file. Will be created automatically.
DATABASE_PATH=./data/podshelf.db

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# Used to sign session tokens. Long random string. Required.
NUXT_SECRET_KEY=change-me-to-a-long-random-string

# Used to encrypt podcast storage credentials and (eventually) GitHub PATs at
# rest in the database. Required when configuring storage. Must be 32 bytes,
# expressed as either 64 hex chars or 44 base64 chars. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PODSHELF_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Site URL
# -----------------------------------------------------------------------------
# The public URL where Podshelf itself is served (used for the built-in
# tracking redirect prefix and admin links).
SITE_URL=https://podshelf.example.com
# Nuxt bakes runtimeConfig.public.* into the client bundle at build time, so
# the public origin has to be re-supplied at runtime via NUXT_PUBLIC_SITE_URL.
# Set this to the same value as SITE_URL on the production host or client-
# generated URLs (e.g. /schedule/*.ics webcal links) will point at localhost.
NUXT_PUBLIC_SITE_URL=https://podshelf.example.com

# -----------------------------------------------------------------------------
# Analytics (optional)
# -----------------------------------------------------------------------------
# Path to a MaxMind GeoLite2-City .mmdb file for download geolocation.
# Leave blank to disable country/region/city tracking.
GEOIP_DB_PATH=

# -----------------------------------------------------------------------------
# First-run setup
# -----------------------------------------------------------------------------
# After installation, create the first admin user with:
#   npm run create-admin
# Additional users and per-podcast storage credentials are configured via
# the admin UI.

# -----------------------------------------------------------------------------
# Deployment (used by scripts/deploy-linode.sh; sourced if this .env exists)
# -----------------------------------------------------------------------------
# SSH target for the production host. Usually an alias from ~/.ssh/config
# that points at the server's origin IP — Cloudflare and most CDNs don't
# proxy port 22, so the public hostname won't accept SSH.
#REMOTE_HOST=my-vps
#REMOTE_USER=root

# Directory the app lives in on the remote host.
#REMOTE_DIR=/opt/podshelf

# Unprivileged user that owns /opt/podshelf and runs the systemd unit.
#APP_USER=podshelf

# systemd unit name on the remote host.
#SERVICE_NAME=podshelf
