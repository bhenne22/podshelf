    <!-- 1. Title with numeric character references inside CDATA — the
         WordPress case. Importer must decode &#8211;, &#8217;, &#8230;
         and let &amp;ampersand survive as a single &. No itunes:episode
         tag, but #146 is in the title — should be inferred. -->
    <item>
      <title><![CDATA[SI #146 &#8211; with &#8217;quotes&#8217; and &amp;ampersand]]></title>
      <description><![CDATA[<p>Show notes &#8211; HTML stays as HTML.</p>]]></description>
      <content:encoded><![CDATA[<p>Full notes with <a href="https://example.com">a link</a> and &#8211; an en-dash.</p>]]></content:encoded>
      <pubDate>Wed, 15 Jan 2025 12:00:00 +0000</pubDate>
      <guid isPermaLink="false">https://example.com/?p=146</guid>
      <enclosure url="https://example.com/audio/146.mp3" length="12345678" type="audio/mpeg"/>
      <itunes:duration>1:23:45</itunes:duration>
    </item>

    <!-- 2. Explicit itunes:episode wins over title pattern. Title also
         has #99 but the tag says 200; importer must use the tag. -->
